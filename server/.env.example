NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Each simulated stage lasts this many milliseconds. No network requests occur.
DEMO_STAGE_DELAY_MS=1000
# Optional server-only Google PageSpeed Insights API key. Blank uses anonymous quota.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=120000
# Durable JSON archive. Relative paths resolve from the backend package directory.
REPORTS_DIR=reports/audits
# Primary SQLite application database. Relative paths resolve from server/.
# AI_USAGE_DB remains separate so adopting the app DB never resets spending history.
DATABASE_PATH=reports/seo-spy.sqlite

# Local WordPress operator module. Keep credentials and the operator key server-only.
WORDPRESS_BUSINESS_ID=
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Generate a private random key of at least 32 characters; send as a Bearer token.
WORDPRESS_OPERATOR_KEY=
# Enables explicit approved content changes AND explicit Rank Math audit triggers.
WORDPRESS_WRITES_ENABLED=false
WORDPRESS_ACTIONS_DIR=reports/wordpress-actions
WORDPRESS_REPORTS_DIR=reports/wordpress-evidence
WORDPRESS_MUSE_DIR=reports/wordpress-muse
WORDPRESS_FRONTEND_ORIGIN=http://localhost:5173

# Mock-first Muse interpretation. Adding a key never enables a real request.
AI_ENABLED=false
MOCK_AI=true
AI_MODE=mock
MODEL_API_KEY=
AI_MODEL=muse-spark-1.3
AI_PROCESSING_MODE=standard
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_BYTES=32768
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_CONCURRENCY=1
# Separate private administrator token for approving individual estimates/demo limits.
AI_ADMIN_KEY=
AI_ADMIN_ORIGIN=http://localhost:5173
# Persistent SQLite usage ledger. Preserve database, sidecars and backups; never reset.
AI_USAGE_DB=reports/ai-usage.sqlite
# USD microdollars: hard development ceilings $2 total/$0.50 UTC day/10 calls.
AI_DEV_BUDGET_MICROS=2000000
AI_DEV_DAILY_MICROS=500000
AI_DEV_MAX_CALLS=10
# Standard undiscounted price snapshot, checked October 31, 2026. Lower rates rejected.
AI_INPUT_PRICE_MICROS_PER_MILLION=1250000
AI_OUTPUT_PRICE_MICROS_PER_MILLION=4250000

# Local Facebook developer testing. Credentials never belong in VITE_ variables.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
FACEBOOK_TOKEN_KEY=
FACEBOOK_CONNECTIONS_DIR=reports/facebook-connections
# Optional user access token for testing before browser OAuth is configured.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/facebook/callback
# Exact local frontend origin permitted to submit Facebook reports through its proxy.
# Use the same hostname as FACEBOOK_REDIRECT_URI so the browser sends its connection cookie.
FACEBOOK_FRONTEND_ORIGIN=http://localhost:5173
