NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Each simulated stage lasts this many milliseconds. No network requests occur.
DEMO_STAGE_DELAY_MS=1000
# Optional server-only Google PageSpeed Insights API key. Blank uses anonymous quota.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=120000
# Durable JSON archive. Relative paths resolve from the backend package directory.
REPORTS_DIR=reports/audits

# Local Facebook developer testing. Credentials never belong in VITE_ variables.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
FACEBOOK_TOKEN_KEY=
FACEBOOK_CONNECTIONS_DIR=reports/facebook-connections
# Optional user access token for testing before browser OAuth is configured.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/facebook/callback
# Exact local frontend origin permitted to submit Facebook reports through its proxy.
# Use the same hostname as FACEBOOK_REDIRECT_URI so the browser sends its connection cookie.
FACEBOOK_FRONTEND_ORIGIN=http://localhost:5173
