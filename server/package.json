{
  "name": "seo-spy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "audit:homepage": "npm run build && node scripts/audit-homepage.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
